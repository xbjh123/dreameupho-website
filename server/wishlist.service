[Unit]
Description=DreamEupho Wishlist API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/dreameupho/server
ExecStart=/usr/bin/python3 /var/www/dreameupho/server/wishlist_api.py 8090 0.0.0.0
Environment=WISHLIST_DB=/var/lib/dreameupho/wishlist.db
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
